# EmailJS — formulaire de contact
# Cree un compte sur https://www.emailjs.com puis recupere les 3 IDs :
#   1. Email Services  → connecter Gmail/Outlook → copier le Service ID
#   2. Email Templates → creer un template avec {{from_name}} {{from_email}} {{subject}} {{message}} → copier le Template ID
#   3. Account → General → copier la Public Key
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
